{
  "name": "figma-finder",
  "author": "Akira HIRATA",
  "version": "1.0.3",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run dev",
    "biome": "biome check --write",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "npm run biome && wxt build && wxt zip",
    "build:firefox": "npm run biome && wxt build -b firefox && wxt zip -b firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "svg-mask-icon": "^2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@figma/rest-api-spec": "^0.41.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.2.5",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "marked": "^18.0.9",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.3"
  }
}
