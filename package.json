{
  "name": "figma-finder",
  "author": "Akira HIRATA",
  "version": "1.0.1",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run dev",
    "biome": "biome check --write",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "npm run biome && wxt build && wxt zip",
    "build:firefox": "npm run biome && wxt build -b firefox && wxt zip -b firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "fuse.js": "^7.1.0",
    "svg-mask-icon": "^2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.3",
    "@figma/rest-api-spec": "^0.34.0",
    "@tsconfig/svelte": "^5.0.5",
    "@types/chrome": "^0.1.27",
    "@wxt-dev/auto-icons": "^1.1.0",
    "@wxt-dev/module-svelte": "^2.0.4",
    "marked": "^16.4.1",
    "svelte": "^5.43.3",
    "svelte-check": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.11"
  }
}
