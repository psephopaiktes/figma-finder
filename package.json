{
  "name": "figma-finder",
  "author": "Akira HIRATA",
  "version": "1.0.4",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "npm run dev --",
    "biome": "biome check --write",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt zip",
    "build:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "check": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "test": "node --test tests/*.test.mjs",
    "submit": "wxt submit"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "svg-mask-icon": "^2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@figma/rest-api-spec": "^0.46.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.3.7",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "marked": "^18.1.2",
    "publish-browser-extension": "^6.2.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
